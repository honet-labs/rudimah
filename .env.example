APP_NAME=RUDIMAH
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_INSTALLER
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=info

# Port Binding
HTTP_PORT=80
HTTPS_PORT=443

# Database MariaDB (Platform)
DB_CONNECTION=platform
DB_PLATFORM_HOST=mariadb
DB_PLATFORM_PORT=3306
DB_PLATFORM_DATABASE=rudimah_platform
DB_PLATFORM_USERNAME=rudimah_user
DB_PLATFORM_PASSWORD=GENERATED_PASSWORD
DB_ROOT_PASSWORD=GENERATED_ROOT_PASSWORD

# Database MariaDB (PEKAN)
DB_PEKAN_HOST=mariadb
DB_PEKAN_PORT=3306
DB_PEKAN_DATABASE=rudimah_pekan
DB_PEKAN_USERNAME=pekan_user
DB_PEKAN_PASSWORD=GENERATED_PEKAN_PASSWORD

# Cache & Redis
BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Layanan AI OCR
OCR_PROVIDER=local_vision
OCR_AUTO_COMMIT=false

# Keamanan & Autentikasi
AUTH_MODEL=App\Core\Identity\Models\User
MFA_REQUIRED_ROLES=owner,admin

# Kanal Notifikasi & Pemulihan (Email, Telegram, WhatsApp WAHA)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@rudimah.id"
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

WAHA_API_URL=
WAHA_API_KEY=
WAHA_SESSION=default
